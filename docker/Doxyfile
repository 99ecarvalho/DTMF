                         /docs/project/.vscode \
                         /docs/project/python_original \
                         /docs/project/__pycache__ \
                         /docs/project/docs

EXCLUDE_PATTERNS       = *doxygen-awesome* \
                         CMakeFiles/* \
                         __pycache__/*

