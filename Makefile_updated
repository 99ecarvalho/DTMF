CC = gcc
CFLAGS = -O2 -Wall -std=c99
BUILD_DIR = build
TARGETS = $(BUILD_DIR)/dtmf_compare $(BUILD_DIR)/dtmf_compare_refactored $(BUILD_DIR)/dtmf_compare_enhanced
SRCS = dtmf_compare.c dtmf_compare_refactored.c

all: $(BUILD_DIR) $(TARGETS)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/dtmf_compare: dtmf_compare.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $< -lm

$(BUILD_DIR)/dtmf_compare_refactored: dtmf_compare_refactored.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $< -lm

$(BUILD_DIR)/dtmf_compare_enhanced: dtmf_compare_refactored.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $< -lm

clean:
	rm -f $(TARGETS)

.PHONY: all clean
