CC = gcc
CFLAGS = -O2 -Wall -std=c99
TARGETS = dtmf_compare dtmf_compare_refactored
SRCS = dtmf_compare.c dtmf_compare_refactored.c

all: $(TARGETS)

dtmf_compare: dtmf_compare.c
	$(CC) $(CFLAGS) -o $@ $< -lm

dtmf_compare_refactored: dtmf_compare_refactored.c
	$(CC) $(CFLAGS) -o $@ $< -lm

clean:
	rm -f $(TARGETS)

.PHONY: all clean
